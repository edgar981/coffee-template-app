# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copia a `.env` y rellena los valores.
# NO comitees `.env` (está en .gitignore). Detalle completo en DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Postgres / Neon) ──────────────────────────────────────────
# Runtime (app y Vercel): usa la conexión POOLED de Neon (host `...-pooler...`).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Migraciones (prisma migrate deploy / dev): conexión DIRECTA de Neon (mismo
# host SIN `-pooler`) — PgBouncer rompe los advisory locks de migrate. La lee
# prisma.config.ts (solo el CLI); el runtime nunca la usa. REQUERIDA en Vercel
# Production (el build corre `migrate deploy` ahí); si falta, el CLI cae a
# DATABASE_URL. En local con Postgres propio puede ser igual a DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Better Auth ──────────────────────────────────────────────────────────────
# Secreto de firma de sesiones. Genera uno: `openssl rand -base64 32`.
BETTER_AUTH_SECRET="genera-un-secreto-largo-y-aleatorio"
# URL base del sitio. Local: http://localhost:3000
# Producción/demo: https://nayoli-demo.duna.solutions
BETTER_AUTH_URL="http://localhost:3000"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Requeridas para enviar invitaciones al panel. Sin ellas, en dev se loguea el
# enlace en consola; en producción la invitación falla (500).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Remitente de las INVITACIONES de admin. (Las notificaciones al cliente usan su
# propio remitente en lib/config/site.ts → tienda.emailRemitente, no esta var.)
EMAIL_FROM="Café Nayoli <no-reply@duna.solutions>"

# ── Notificaciones al cliente (orden creada / en camino) ─────────────────────
# Redirect de dev/preview: si está seteada, TODO correo al cliente va a esta
# dirección (con el destinatario real en el asunto: "... [para: cliente@x]").
# En PRODUCCIÓN se deja SIN setear para que llegue al cliente real.
# Requiere RESEND_API_KEY para enviar de verdad; sin key, solo se loguea.
NOTIFICATIONS_REDIRECT_EMAIL="tu-inbox-de-pruebas@example.com"

# ── Cron de automatizaciones ─────────────────────────────────────────────────
# Secreto compartido que protege POST /api/cron/automations. Sin él el endpoint
# responde 503 (CERRADO, no abierto); con un valor equivocado, 401.
# Genera uno: `openssl rand -hex 32`.
# El MISMO valor va en DOS lugares:
#   1. Env var de Vercel (Production; también Preview si quieres probar allí).
#   2. GitHub → Settings → Secrets and variables → Actions → secret CRON_SECRET.
# El disparo horario lo hace .github/workflows/automations-cron.yml (el plan Hobby
# de Vercel sólo corre sus crons una vez al día). Opcional: la variable de repo
# CRON_URL para apuntar a otro dominio que el de producción.
CRON_SECRET="genera-un-secreto-largo-y-aleatorio"

# ── Seed del demo (SOLO local, no van a Vercel) ──────────────────────────────
# Las tres son SOLO del seed (`prisma db seed`). Sin ellas el seed crea el OWNER
# con credenciales PÚBLICAS por defecto (admin@sierranativa.co / ChangeMe123!);
# defínelas para un demo seguro.
#
# El destinatario runtime de los reportes al equipo YA NO es una env var: vive en la
# base (SiteSetting.adminEmail, editable en Configuración) o en el campo
# "Destinatarios" de cada reporte. ADMIN_EMAIL se retiró — su doble función (login del
# seed + destinatario) era la trampa que este cambio deshace.
SEED_OWNER_EMAIL="owner@tu-dominio.com"
ADMIN_PASSWORD="una-contraseña-fuerte"
ADMIN_NAME="Administrador"

# ── WhatsApp (Meta) — PENDIENTE, no existe todavía ───────────────────────────
# El canal de WhatsApp de las automatizaciones es un stub deliberado
# (lib/automations/channels/whatsapp.ts): todo el pipeline corre y el run queda
# PENDIENTE_CANAL con el mensaje ya renderizado, pero no hay llamada HTTP.
# Cuando se conecte Meta harán falta:
#   WHATSAPP_PHONE_NUMBER_ID="..."
#   WHATSAPP_ACCESS_TOKEN="..."
# Twilio (TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_WHATSAPP_FROM) fue
# RETIRADO: era un sandbox que nunca pasó de una prueba. Si siguen puestas en
# Vercel o en un .env viejo, bórralas — ya no las lee nada.
