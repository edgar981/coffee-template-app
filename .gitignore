# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local config
/.claude

# typescript
*.tsbuildinfo
next-env.d.ts

/packages/core/src/generated/prisma

# scratch PR body (not part of the project)
/PR_BODY.md

# scratch commit-message drafts a worker writes to disk before `git commit -F` (§ Commit msg con
# backticks) — untracked leftovers from a prior slice block the guard that gates the next dispatch.
.git-commit-msg-*

# throwaway files a slice worker writes mid-task (commit-message drafts, one-off scripts, counts) —
# a NAMED directory instead of chasing unpredictable filenames, so an untracked leftover never again
# blocks the next dispatch's guard.
.scratch/

# Mapa de los repos de Carlos — material de la sesión de asesoría, no del producto.
/CARTOGRAFIA-DUNA.md
