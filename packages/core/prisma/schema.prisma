generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(STAFF)
  // Acceso al panel. NO se borra un usuario: aparece como actor en columnas de
  // auditoría (Payment.registrado_por, Comprobante.verificado_por) y una salida
  // del equipo es un hecho reversible, no la desaparición de la persona. Misma
  // semántica que `Product.activo` y `Customer.activo`.
  //
  // El gate del panel lo exige (app/(admin)/admin/layout.tsx) y al desactivar se
  // borran además sus filas de `session`: el chequeo corta el acceso en el
  // siguiente request, y el borrado no deja una credencial válida colgando.
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  account       account[]
  session       session[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Invitation {
  id        String    @id @default(cuid())
  email     String
  name      String?
  role      Role
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum Role {
  OWNER // client (restaurant owner) - full access
  MANAGER // their manager - most access
  STAFF // waiter/delivery - limited access
}

model Customer {
  id             String   @id @default(cuid())
  nombre         String
  email          String?  @unique
  telefono       String?
  ciudad         String?
  direccion      String?
  canal          String?  @default("directo")
  notas          String?
  activo         Boolean  @default(true)
  numero_ordenes Int      @default(0)
  total_compras  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model Product {
  id                String      @id @default(cuid())
  nombre            String
  slug              String      @unique
  descripcion       String      @default("")
  categoria         String
  precio            Float       @default(0)
  costo             Float       @default(0)
  sku               String?     @unique
  stock             Int         @default(0)
  stock_minimo      Int         @default(5)
  activo            Boolean     @default(true)
  peso_gramos       Int?
  variante          String?
  origen            String?
  tostado           String?
  // Ficha técnica estructurada (empaque real) — editable desde el admin.
  // La tostión reutiliza el campo `tostado` existente (no se duplica).
  variedad          String?
  proceso           String?
  altitudMin        Int?
  altitudMax        Int?
  // Molienda del producto (p. ej. "Media") — solo variantes molidas; null en grano.
  molienda          String?
  // Opciones de molienda que ve el cliente en la página de producto:
  // [{ nombre: "Media", metodo: "Filtro / Greca tradicional", disponible: true }, …]
  // El admin activa nuevas moliendas cambiando `disponible` — sin cambios de código.
  moliendasOpciones Json?
  notasCata         String[]    @default([])
  // Tags cortos del card del catálogo (p. ej. "Chocolate" · "Herbal").
  notas             String[]    @default([])
  // Copy corto para el card del catálogo (la `descripcion` es la larga del detalle).
  descripcionCorta  String?
  imagen            String      @default("")
  imagenes          String[]    @default([])
  bestseller        Boolean     @default(false)
  badge             String?
  agotado           Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
}

model Order {
  id                 String        @id @default(cuid())
  numero_orden       String        @unique
  // Client-generated key that makes order creation idempotent: a double submit or
  // network retry reuses the same key and returns the existing order instead of
  // creating a duplicate. Nullable + unique (Postgres allows many NULLs), so
  // legacy and checkout orders without a key are unaffected.
  idempotencyKey     String?       @unique
  // The Customer this order belongs to. Set by createOrderWithCustomer from the
  // very upsert that resolves identity, so it is exact — unlike matching on the
  // snapshots below. Nullable: historical orders may not resolve to anyone, and
  // deleting a customer must NOT delete their orders (financial records), hence
  // onDelete: SetNull.
  cliente_id         String?
  cliente            Customer?     @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  // PURCHASE-TIME SNAPSHOTS — deliberately NOT redundant with the relation.
  // These record who bought, as stated at the time; the Customer record reflects
  // who they are now. Editing a profile must never rewrite past orders.
  cliente_nombre     String?
  cliente_email      String?
  cliente_telefono   String?
  canal              String        @default("directo")
  estado             String        @default("pendiente")
  // CONDICIÓN de pago — CUÁNDO se paga respecto al despacho. ANTICIPADO: pago →
  // Shipping → despacho (no se despacha sin pago). CONTRAENTREGA: el envío puede
  // prepararse y despacharse con la orden `pendiente`; el Payment se registra al
  // cobrar tras la entrega (Payment.metodo = el instrumento real). NO es un
  // método de pago. Inmutable una vez la orden tiene Shipping o Payment.
  condicion_pago     CondicionPago @default(ANTICIPADO)
  // Free-string method DECLARED at checkout (lowercase: "nequi", "efectivo"…).
  // Legacy/storefront intent; kept for those orders. Admin orders use the typed
  // `metodoPagoPrevisto` below instead.
  metodo_pago        String?
  // DECLARED payment intent for an ADMIN-created order: the method the customer
  // SAID they'll pay by. It is NOT the money — it does not create a Payment, does
  // not change `estado`, and the order still starts `pendiente`. When the real
  // payment is registered later it may differ (the Payment wins; this stays as
  // the order's historical intent). Same enum as Payment.metodo. Checkout leaves
  // it null (see metodo_pago above). Nullable = "Por definir".
  metodoPagoPrevisto MetodoPago?
  total              Float         @default(0)
  costo_envio        Float         @default(0)
  direccion_entrega  String?
  direccion_detalle  String?
  ciudad_entrega     String?
  notas_internas     String?
  notas_entrega      String?
  deliverySlot       String?
  items              OrderItem[]
  payments           Payment[]
  comprobantes       Comprobante[]
  shipping           Shipping?
  transiciones       OrderStatusTransition[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([cliente_id])
}

// ─── Libro de transiciones de estado (append-only) ───────────────────────────
// El "Recorrido del pedido": cada cambio de estado de CUALQUIERA de los dos ejes
// —cobro (Order.estado) y fulfillment (Shipping.estado)— escribe UNA fila. Es un
// LIBRO: nunca se borra ni se edita. `Order.updatedAt` sólo dice el último write;
// esto dice la historia. Lo escriben los cinco funnels vía appendOrderStatusTransition.
model OrderStatusTransition {
  id              String   @id @default(cuid())
  orden_id        String
  order           Order    @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  // Eje del estado que cambió: 'cobro' | 'fulfillment'. Una fila por transición de
  // cualquiera de los dos; el discriminador es lo que permite mezclarlos.
  eje             String
  // from/to como STRING, no enum: cada eje tiene su PROPIO vocabulario (cobro:
  // pendiente/pagado/cancelado; fulfillment: preparando/en_ruta/entregado/fallido).
  // Un enum forzaría uno solo y dejaría fuera al otro eje.
  // `estado_anterior` NULLABLE a propósito: una orden que NACE no tiene estado
  // previo (creación → estado_anterior:null, estado_nuevo:'pendiente'). Decisión
  // explícita, no el default de Prisma. Mismo par que InventoryLog (anterior/nuevo).
  estado_anterior String?
  estado_nuevo    String
  // Actor SNAPSHOT sin FK (patrón Payment/Comprobante): id + nombre congelados,
  // sobreviven a que el usuario se desactive o se borre. Nullable: transiciones sin
  // humano (checkout del storefront, efectos del sistema).
  actor_id        String?
  actor_nombre    String?
  // CLAVE DE ORDEN GLOBAL de la timeline: se lee cronológicamente MEZCLANDO los dos
  // ejes. Distinta de createdAt (auditoría técnica de cuándo se escribió la fila).
  occurred_at     DateTime @default(now())
  createdAt       DateTime @default(now())

  // La timeline lee por orden ordenada por tiempo; append-only, crece para siempre.
  // Sin este índice, cada lectura escanearía la tabla entera.
  @@index([orden_id, occurred_at])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orden_id             String
  producto_id          String?
  producto_nombre      String
  // Molienda elegida por el cliente al comprar (snapshot, p. ej. "Media").
  moliendaSeleccionada String?
  cantidad             Int
  precio_unitario      Float?
  subtotal             Float
  order                Order    @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [producto_id], references: [id])
}

model InventoryLog {
  id              String   @id @default(cuid())
  producto_id     String
  producto_nombre String
  tipo            String
  cantidad        Int
  stock_anterior  Int
  stock_nuevo     Int
  motivo          String?
  createdAt       DateTime @default(now())
}

// A Payment is an event OF an Order: created when the admin registers a received
// payment, moving the order to `pagado` in the SAME transaction. `monto` is a
// snapshot of the order total at registration time (never typed by hand); the
// customer is read live through the relation. There is no payment `estado` — a
// row's existence IS the received payment; pending/paid lives on the Order.
model Payment {
  id                    String     @id @default(cuid())
  orden_id              String
  order                 Order      @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  monto                 Float
  metodo                MetodoPago
  referencia            String?
  notas                 String?
  // Who registered it (admin session). Snapshotted so it survives user deletion.
  registrado_por        String?
  registrado_por_nombre String?
  // Business payment date (defaults to registration). `createdAt` is the audit ts.
  fecha                 DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([orden_id])
}

// ─── El comprobante es la EVIDENCIA, no la plata ─────────────────────────────
//
// `Payment` y `Comprobante` son dos hechos distintos y por eso son dos tablas
// (decisión de arquitectura, documento Duna §3.1). Una orden puede tener:
//   • comprobante SIN pago — el cliente mandó la foto y nadie la verificó aún;
//   • pago SIN comprobante — efectivo contraentrega, no hay nada que fotografiar.
// Colapsarlos en un campo `Payment.comprobante_url` haría imposible el primer
// caso, que es justamente el que esta tanda existe para resolver.
//
// La IMAGEN NO VIVE ACÁ: `url` es un puntero a Vercel Blob (lib/storage.ts, bajo
// el prefijo `comprobantes/` con su `dev/` por entorno). Bytes en Postgres
// hincharían los backups y las copias de rama por un dato que un CDN sirve mejor.
//
// SIN BORRADO FÍSICO, como el resto del repo: `RECHAZADO` conserva la fila Y la
// imagen. Un comprobante rechazado es la prueba de que se rechazó — borrarlo
// dejaría una orden sin explicación de por qué su pago nunca entró.
model Comprobante {
  id                    String            @id @default(cuid())
  // `orden_id` y no `order_id`, por la convención que ya fijó Payment.
  orden_id              String
  order                 Order             @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  // Puntero al blob. La URL es inmutable (el proveedor le pone sufijo aleatorio),
  // así que sirve de clave de caché.
  url                   String
  // Se snapshotean del archivo subido: el content-type decide si hay miniatura o
  // chip de documento, y el tamaño se muestra sin tener que pedirle nada al CDN.
  content_type          String
  size_bytes            Int
  estado                ComprobanteEstado @default(RECIBIDO)
  // Quién subió y quién verificó, con NOMBRE snapshoteado — mismo criterio que
  // `Payment.registrado_por_nombre`: sobrevive a que el usuario se elimine, y la
  // pantalla tiene que poder decir "verificado por X" sin un join a Better Auth.
  subido_por            String?
  subido_por_nombre     String?
  verificado_por        String?
  verificado_por_nombre String?
  verificado_at         DateTime?
  notas_verificacion    String?
  createdAt             DateTime          @default(now())

  @@index([orden_id])
}

// RECIBIDO: llegó, nadie lo miró. VERIFICADO: un humano confirmó que la plata
// entró. RECHAZADO: un humano lo miró y no sirve (monto que no cuadra, captura
// de otra orden, imagen ilegible).
//
// NINGUNO de los tres mueve `Order.estado`: el único que pasa una orden a
// `pagado` sigue siendo el Payment. El comprobante es evidencia sobre la plata,
// no la plata.
enum ComprobanteEstado {
  RECIBIDO
  VERIFICADO
  RECHAZADO
}

// Manual payment methods. Extensible for online rails later (e.g. WOMPI) via
// `ALTER TYPE "MetodoPago" ADD VALUE 'WOMPI'`.
enum MetodoPago {
  NEQUI
  DAVIPLATA
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

// Condición de pago de la orden (ver Order.condicion_pago). Es una CONDICIÓN,
// no un método: el instrumento real queda en Payment.metodo al recibir el dinero.
enum CondicionPago {
  ANTICIPADO
  CONTRAENTREGA
}

// Tipo de envío del despacho: LOCAL (mensajero propio) o NACIONAL (transportadora
// + número de guía en Shipping.transportadora / numero_guia).
enum TipoEnvio {
  LOCAL
  NACIONAL
}

model Shipping {
  id                  String    @id @default(cuid())
  // One Shipping per Order (1:1). Auto-created in `preparando` when the order is
  // paid. Number, customer AND address are read live via the relation — the
  // Shipping keeps no copy of them. Only costo_envio is snapshotted (below).
  orden_id            String    @unique
  order               Order     @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  // Zona and courier start empty; the operator fills them when scheduling.
  zona                String?
  // Zona que la heurística de dirección (lib/zona-config.ts) sugirió cuando el
  // operador programó. Solo auditoría de calidad: una CORRECCIÓN se deriva
  // comparando `zona_sugerida != zona` — no hay (ni debe haber) un campo
  // "corregida" que pueda desincronizarse de esa comparación. Null = no hubo
  // sugerencia (dirección atípica o sin ciudad).
  zona_sugerida       String?
  estado              String    @default("preparando")
  costo_envio         Float     @default(0)
  mensajero           String?
  notas_entrega       String?
  fecha_programada    String?
  fecha_entrega       String?
  // LOCAL (mensajero propio) o NACIONAL (transportadora). Los campos de guía se
  // usan cuando NACIONAL; el operador los llena al programar.
  tipo_envio          TipoEnvio @default(LOCAL)
  transportadora      String?
  numero_guia         String?
  // Marcador de idempotencia del descuento de stock AL DESPACHAR (en_ruta): el
  // decremento corre SOLO si esto es null y lo setea en la misma transacción;
  // la devolución (fallido/cancelado tras despacho) restituye y lo limpia.
  // Flapping o reintentos jamás descuentan dos veces.
  stock_descontado_at DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// El modelo `Automation` vivió aquí hasta la migración
// 20260729120000_drop_automation_legacy (fase CONTRACT). Lo reemplazan los dos
// modelos de abajo: `AutomationSetting` guarda la decisión del owner y
// `AutomationRun` sustituye sus contadores agregados (`veces_ejecutada`,
// `ultima_ejecucion`) por una fila por ejecución, con target, canal, estado y
// payload. No reintroducir: el catálogo vive en constants/automations.ts.

// Lo ÚNICO que el owner decide de una automatización: si está encendida y sus
// overrides de configuración. Todo lo demás —nombre, canal, disparador, plantillas
// y los DEFAULTS de config— vive en el REGISTRY de código (constants/automations.ts),
// igual que el catálogo de widgets del dashboard.
//
// `key` es la PK: es una constante del registry (snake_case estable), no un id
// generado — no hay identidad de fila más allá de la key. Sin fila = todo por
// default (registry). Una key retirada del registry deja una fila inerte que nadie
// lee; una key nueva no necesita fila hasta que alguien la toque.
//
// `config` guarda SOLO overrides, parseados contra el `configSchema` (zod) del
// registry en cada lectura: un JSON viejo o corrupto degrada a los defaults en vez
// de romper el barrido. Ver lib/automations/settings.ts (gate único).
model AutomationSetting {
  key       String   @id
  activo    Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AutomationRunEstado {
  ENVIADO // el canal confirmó el despacho
  PENDIENTE_CANAL // pipeline completo, canal sin conectar todavía (WhatsApp/Meta)
  FALLIDO // el canal reventó; el negocio siguió intacto
  OMITIDO // disparó pero no había a quién/qué enviar (sin teléfono, etc.)
  // Se evaluó el target y se calló A PROPÓSITO porque ya estaba atendido. Es
  // rastro del INTENTO, no de un envío: sin él, "callé porque el cooldown lo
  // pidió" y "callé porque estoy roto" se ven idénticos desde la base (cero
  // filas en ambos casos), que es lo que costó una tarde de diagnóstico.
  //
  // OJO: estas filas NO cuentan para la ventana de cooldown (ver
  // `estaEnCooldown`). Si contaran, cada silencio generaría la evidencia que
  // causa el siguiente y la automatización quedaría muda para siempre.
  //
  // Solo la escriben las estrategias `cooldown`: en las demás el periodo es fijo
  // y el unique (key, target, periodo) ya está ocupado por el run original, que
  // ES la explicación del silencio.
  DUPLICADO
}

// Bitácora de TODA ejecución de una automatización: la idempotencia de los barridos
// y la auditoría que contesta "¿ya le recordamos a esta orden?". Se escribe SIEMPRE,
// incluso cuando el envío falla o se omite — un intento que no dejó rastro es un
// intento que se va a repetir.
//
// `periodo` NUNCA es null, a propósito: en Postgres dos NULL no colisionan, así que
// un `periodo` nulo anularía silenciosamente el unique de abajo. Su forma la decide
// la estrategia de idempotencia de cada automatización (registry → `idempotencia`):
//
//   'una_vez'  → 'evt'          — una vez por target, para siempre (el unique ES el gate)
//   'diaria'   → '2026-07-27'   — una por día local Bogotá (el unique ES el gate)
//   'semanal'  → '2026-W31'     — una por semana ISO (el unique ES el gate)
//   'cooldown' → ISO instant    — el unique NO aplica (cada valor es único); el gate
//                                 real es la consulta de la última corrida dentro de
//                                 `cooldownHoras`. Ver lib/automations/idempotency.ts.
//
// `targetId` es 'global' para las que no apuntan a una fila (reportes agregados).
model AutomationRun {
  id            String              @id @default(cuid())
  automationKey String
  targetType    String // 'order' | 'product' | 'customer' | 'shipping' | 'global'
  targetId      String
  periodo       String
  canal         String
  estado        AutomationRunEstado
  // Mensaje renderizado + destinatario + variables. Es la EVIDENCIA revisable de un
  // run PENDIENTE_CANAL: lo que se habría enviado, listo para comparar el día que
  // el adaptador de Meta se conecte.
  payload       Json?
  createdAt     DateTime            @default(now())

  @@unique([automationKey, targetId, periodo])
  // Sirve al contador "últimas ejecuciones" de cada card (3 más recientes por key).
  @@index([automationKey, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(cuid())
  tipo      String // 'stock_bajo', 'nueva_orden', etc.
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  href      String? // optional link to relevant page
  createdAt DateTime @default(now())
}

// Per-admin dashboard layout: which stat-card widgets they see and in what order.
// `widgets` is an ordered JSON array of widget `key`s (see constants/dashboard-
// widgets.ts) — validated against that registry on write, and filtered against it
// on read, so a retired or unknown key never breaks the dashboard.
//
// `userId` references `user.id` (Better Auth) but is deliberately NOT a Prisma
// relation: adding one would require a back-relation field on the Better Auth
// `user` model, which we don't touch. It's uniquely indexed (one row per user);
// the app scopes every read/write to the session user. An orphan row after a user
// deletion is harmless (nothing reads it).
//
// MULTITENANT SEAM (not built): when a store/tenant model exists, this gains a
// store key and the unique index becomes composite (userId + storeId), so the
// same admin can hold a different layout per store. See CLAUDE.md.
model DashboardPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
